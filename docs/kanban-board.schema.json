{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm.local/schemas/kanban-board.json",
  "title": "BoardData",
  "description": "Kanban board document stored in boards.data_json",
  "type": "object",
  "required": ["columns", "cards"],
  "additionalProperties": false,
  "properties": {
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "cardIds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "cardIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "cards": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "title", "details"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "details": { "type": "string" }
        }
      }
    }
  }
}
